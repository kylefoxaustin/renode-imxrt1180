// MIMXRT1189 — CM7 standalone platform (Zephyr's cm7 board target).
//
// The M7 is the ONLY core here, so its LOCAL view is the global view:
// ITCM @ 0x0 and DTCM @ 0x20000000, which is exactly what Zephyr's cm7 target
// links against (`zephyr,flash = &itcm`, `zephyr,sram = &dtcm`; measured: ELF
// LOAD at 0x0 and 0x20000000, `_vector_table` at 0x0).
// This complements mimxrt1189_m2.repl, where the same TCMs are cpu1-scoped
// aliases of the system-view block at 0x303C0000.

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    // M7 has 4 priority bits [brief]; __NVIC_PRIO_BITS = 4 in
    // MIMXRT1189_cm7_COMMON.h. [cmsis]
    priorityMask: 0xF0
    // ⭐ 792 MHz, DERIVED AND CITED -- was 798, which was wrong by 0.76%.
    // The SDK's board clock config drives the M7 root from the ARM PLL with
    // div 1 (project_template/clock_config.c: kCLOCK_M7_ClockRoot_MuxArmPllOut,
    // div 1), and that PLL is configured loopDivider 132 / postDivider 2:
    //     Fout = Fin * (loopDivider / (2 * postDivider))
    //          = 24 MHz * (132 / 4) = 24 MHz * 33 = 792 MHz
    // CMSIS agrees: system_MIMXRT1189_cm7.h:73 DEFAULT_SYSTEM_CLOCK 792000000UL.
    // Found while checking my own numbers after catching the same CLASS of error
    // in the oracle's machine (their M33 read 300 where it should read 240, and
    // chasing it showed their M7 read 300 where it should read 792). Mine was a
    // smaller slip in the same place -- which is why I went and looked.
    systickFrequency: 792000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    nvic: nvic
    // SDK board.c programs MPU region 12; the architecture allows only 8 or 16.
    // See the note in mimxrt1189_cm33.repl. DERIVED, labelled.
    numberOfMPURegions: 16

// M7 ITCM / DTCM, 256 KiB each (IMXRT1180_M7_TCM_HALF = 0x40000). [oracle]
itcm: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x40000

dtcm: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x40000

// Shared SoC RAM [brief]
ocram1: Memory.MappedMemory @ sysbus 0x20484000
    size: 0x7C000

ocram2: Memory.MappedMemory @ sysbus 0x20500000
    size: 0x40000

// ---- Console: LPUART12, NOT LPUART1 ----
// Zephyr's cm7 board target uses `zephyr,console = &lpuart12`, where the cm33
// target uses lpuart1. LPUART12_BASE = 0x44580000, LPUART12_IRQn = 159. [cmsis]
// Same fifoSize rationale as LPUART1 (FSL_FEATURE_LPUART_FIFO_SIZEn == 16).
lpuart12: UART.NXP_LPUART @ sysbus 0x44580000
    fifoSize: 16
    IRQ -> nvic@159

// ---- Blocks the SDK/Zephyr board init touches (same models as the CM33 side) ----
anadig: Miscellaneous.IMXRT1180_Anadig @ sysbus 0x44480000
ccm: Miscellaneous.IMXRT1180_CCM @ sysbus 0x44450000
xcache: Miscellaneous.IMXRT1180_Xcache @ sysbus 0x44400000
s3mu: Miscellaneous.IMXRT1180_S3MU @ sysbus 0x47540000
dcdc: Miscellaneous.IMXRT1180_PeriphRdy @ sysbus 0x44520000
    readyOffset: 0x0
    readyMask: 0x80000000

trdc1: Miscellaneous.IMXRT1180_TRDC @ sysbus 0x44270000
    ncmMask: 0x04

trdc2: Miscellaneous.IMXRT1180_TRDC @ sysbus 0x42460000
    ncmMask: 0x1C

trdc3: Miscellaneous.IMXRT1180_TRDC @ sysbus 0x42810000
    ncmMask: 0x1B

blkctrl_wakeupmix: Miscellaneous.IMXRT1180_PeriphRdy @ sysbus 0x42420000

// ── THE FULL PERIPHERAL COMPLEMENT, ON THE M7 SIDE TOO ───────────────────────
// The M7 is a real core on the same die and sees the same peripheral space; the
// QEMU machine gives both cores one set. This platform carried only the boot
// essentials, so firmware addressing SAI, LPSPI, FlexCAN, GPT, LPTMR, eDMA or
// MECC from the M7 hit unmapped space.
//
// ⚠ EVERY BLOCK BELOW IS COPIED VERBATIM FROM mimxrt1189_m1.repl, NOT RETYPED.
// The first attempt at this section was written from memory and fabricated THREE
// bases -- mecc1 0x44430000 (real: 0x42920000), usbphy1 0x4C400000 (real:
// 0x42CA0000), usbphy2 0x4C500000 (real: 0x42CB0000) -- and put an `0 -> nvic@45`
// on SAI, which has no numbered GPIO output at all (Error E14). m1's values are
// the ones already checked against the oracle's cfg tables.
//
// adc1/adc2 are deliberately NOT here: mimxrt1189_cm7_sdk.repl, which inherits
// this file, declares them, and Renode rejects a redeclaration (Error E02).

usbphy1: Miscellaneous.IMXRT1180_USBPHY @ sysbus 0x42CA0000

usbphy2: Miscellaneous.IMXRT1180_USBPHY @ sysbus 0x42CB0000

// ---- USB_OTG1/2 (ChipIdea USB-HS, device mode) ---------------------------
// Ported from the QEMU oracle's hw/usb/imxrt1180_usb.c. Bases SOURCED from the
// MIMXRT1189 CMSIS header (USB_OTG1_BASE 0x42C80000, USB_OTG2_BASE 0x42C90000);
// IRQs 215/214 from the oracle's imxrt1180_soc.h. No USB host is attached and
// none is fabricated -- the device completes init/run and stays un-enumerated,
// which is the honest outcome for a headless target.

lpspi3: SPI.IMXRT1180_LPSPI @ sysbus 0x42550000
    0 -> dmareq4@12
    1 -> dmareq4@13

gpt2: Timers.IMXRT1180_GPT @ sysbus 0x42EC0000
    0 -> nvic@210

lptmr1: Timers.IMXRT1180_LPTMR @ sysbus 0x44300000
    0 -> nvic@18

// ---- SEMA42 / VREF / CMP1 (imxrt1180-misc1: three blocks, one row) ---------

flexcan3: CAN.IMXRT1180_FlexCAN @ sysbus 0x445B0000
    0 -> nvic@191

sai1: Sound.IMXRT1180_SAI @ sysbus 0x443B0000
    ccm: ccm
    dma: edma3
    clockRoot: 65
    dmaRequestSource: 21
    param: 0x00050402
    // IRQ 45, from the oracle's sai_cfg[] (imxrt1180_soc.c:868). The ASRC example
    // drives SAI through the INTERRUPT path (SAI_TransferSendNonBlocking), not
    // eDMA -- without this line it waits forever on isSAIFinished.
    IRQ -> nvic@45

// ---- SAI2/3/4 ------------------------------------------------------------
// Added because the ASRC's TRUE-ASYNC ratio is (outSrcHz / inSrcHz), and those
// sources are SAIn TX bit clocks: imxrt1180-asrc-async selects SAI1_TX for input
// (ASRCSR AICSA=0) and SAI2_TX for output (AOCSA=2). With only SAI1 present the
// ASRC could not resolve the output source and correctly fell back to the divider
// ratio -- giving 1 where the true ratio is 2.
//
// Bases, IRQs and PARAMs all SOURCED from the oracle's sai_cfg[]/sai_param[]
// (imxrt1180_soc.c:940) and clock roots from CLKROOT_SAI1 + i (65..68).
// ⚠ PARAM DIFFERS PER INSTANCE and the oracle's own comment records that giving
// all four the same value made "every instance wrong": SAI1 advertises a 16-word
// FIFO (PARAM[11:8]=4), SAI2/3 32-word (=5), SAI4 (=5 with a different channel
// count). A driver sizing a burst from PARAM overruns a FIFO shallower than the
// one it was promised, so these are copied, not guessed.

edma4: DMA.IMXRT1180_eDMA @ {
        sysbus new Bus.BusPointRegistration { address: 0x42000000 }
    }
    // ⚠ LABELLED DEVIATION: RT1180's eDMA4 has 64 channels; Renode's model
    // hard-caps at 32 (MP_INT/MP_HRS are single 32-bit registers, one flag per
    // channel; eDMA4 needs L/H pairs). The driver examples use low channel
    // numbers. Channels 32-63 DO NOT EXIST in this platform.
    // eDMA4 uses GROUPED interrupts: channels 2k, 2k+1, 2k+32 and 2k+33 all
    // share NVIC IRQ 128+k (16 IRQs, 128..143 for 64 channels). Verified against
    // the QEMU oracle (hw/arm/imxrt1180_soc.c: "eDMA4 (64 channels, grouped IRQ:
    // channels 2k/2k+1/2k+32/2k+33 share IRQ 128+k)"). This platform declares 32
    // channels, so only the 2k / 2k+1 half of each group is present.
    numberOfChannels: 32
    0 -> nvic@128
    1 -> nvic@128
    2 -> nvic@129
    3 -> nvic@129
    4 -> nvic@130
    5 -> nvic@130
    6 -> nvic@131
    7 -> nvic@131
    8 -> nvic@132
    9 -> nvic@132
    10 -> nvic@133
    11 -> nvic@133
    12 -> nvic@134
    13 -> nvic@134
    14 -> nvic@135
    15 -> nvic@135
    16 -> nvic@136
    17 -> nvic@136
    18 -> nvic@137
    19 -> nvic@137
    20 -> nvic@138
    21 -> nvic@138
    22 -> nvic@139
    23 -> nvic@139
    24 -> nvic@140
    25 -> nvic@140
    26 -> nvic@141
    27 -> nvic@141
    28 -> nvic@142
    29 -> nvic@142
    30 -> nvic@143
    31 -> nvic@143

edma4_channels: DMA.IMXRT1180_eDMA_Channels @ {
        sysbus new Bus.BusPointRegistration { address: 0x42010000 }
    }
    dma: edma4
    count: 32
    channelSize: 0x8000

// ---- Blocks the SDK board init needs on any rung (same as the M2 platform) ----
// TRDC1..3: fsl_trdc reads HWCFG0 to size its loops and asserts on zero counts.
// Bases + ncmMask from the QEMU oracle's trdc_base[] / trdc_ncm_mask[].

mecc1: Miscellaneous.IMXRT1180_MECC @ sysbus 0x42920000
    ocramSize: 0x7C000
    IRQ -> nvic@91

// ---- Console [brief]: LPUART1 @ 0x44380000, IRQ 19 ----
// IRQ 19 confirmed independently: LPUART1_IRQn = 19 in both the cm33 and cm7
// CMSIS headers. [cmsis]
// The built image references 0x44380000 (the NON-SECURE alias) 3 times and the
// secure alias 0x54380000 zero times, so the NS registration alone suffices for
// M0. [elf]  The secure alias is added anyway (+0x1000_0000) because the CMSIS
// header defines LPUART1_BASE as 0x54380000 for secure builds. [cmsis]

// mecc2 is NOT declared on the M7 side. In cm33 the ECC model IS the OCRAM2
// provider (it registers a BusMultiRegistration over 0x20500000 and there is no
// separate ocram2 there); this platform declares ocram2 as plain MappedMemory,
// so importing mecc2 collides -- "conflicts with peripheral MappedMemory
// registered at <0x20500000, 0x2053FFFF>" (Error E39). Two valid arrangements of
// the same region; taking mecc1 alone keeps this one intact.

edma3: DMA.IMXRT1180_eDMA @ {
        sysbus new Bus.BusPointRegistration { address: 0x44000000 }
    }
    numberOfChannels: 32
    0 -> nvic@95
    1 -> nvic@96
    2 -> nvic@97
    3 -> nvic@98
    4 -> nvic@99
    5 -> nvic@100
    6 -> nvic@101
    7 -> nvic@102
    8 -> nvic@103
    9 -> nvic@104
    10 -> nvic@105
    11 -> nvic@106
    12 -> nvic@107
    13 -> nvic@108
    14 -> nvic@109
    15 -> nvic@110
    16 -> nvic@111
    17 -> nvic@112
    18 -> nvic@113
    19 -> nvic@114
    20 -> nvic@115
    21 -> nvic@116
    22 -> nvic@117
    23 -> nvic@118
    24 -> nvic@119
    25 -> nvic@120
    26 -> nvic@121
    27 -> nvic@122
    28 -> nvic@123
    29 -> nvic@124
    30 -> nvic@125
    31 -> nvic@126
edma3_channels: DMA.IMXRT1180_eDMA_Channels @ {
        sysbus new Bus.BusPointRegistration { address: 0x44010000 }
    }
    dma: edma3
    count: 32
    channelSize: 0x10000

// ---- SAI1 (I2S transmit path) --------------------------------------------
// Ported from the QEMU oracle's hw/misc/imxrt1180_sai.c. Base SOURCED from the
// CMSIS header. The sample rate is COMPUTED from the guest's own registers via
// the CCM clock tree (CLOCK_ROOT[65]) -- never a constant; see the .cs.
// PARAM is PER INSTANCE (the RM's per-instance reset values): SAI1 0x00050402
// gives a 16-word FIFO. TX DMA request is SRC 21 on eDMA3, from the oracle's
// sai_tx_dma[] table (imxrt1180_soc.c:917).
dmareq3: Miscellaneous.IMXRT1180_DMARequestRouter @ none
    DMA: edma3

// ---- Timers: LPIT1 / TMR1 / GPT1 / TPM1 / LPTMR1 --------------------------
// Bases and IRQs from @rt1180emulator's per-block anchors. Each of these blocks
// was previously ABSENT, and the tests that need them did not fail -- they HUNG,
// spinning on a status bit nothing ever set, which the sweep recorded as NO-OUTPUT.
//
// Three traps are modelled deliberately and are worth naming at the registration
// site, because each is the kind of thing a reasonable implementation gets wrong:
//   LPIT   CVAL must really DECREMENT -- the test reads the counter back, so a
//          flag-only model passes the IRQ check and fails the read.
//   TMR    SCTRL.TCF is cleared by WRITING 0, not W1C. The opposite of convention.
//   LPTMR  CNR requires a preceding WRITE to latch; the data is irrelevant, the
//          write IS the latch. Serving it live would be more helpful than silicon.
dmareq4: Miscellaneous.IMXRT1180_DMARequestRouter @ none
    DMA: edma4

// ---- eDMA3 request router + LPI2C1 DMA request lines ----------------------
// ⭐ THE INSTANCE MATTERS AND I HAD THE WRONG ONE IN MIND. imxrt1180-lpi2c-dma uses
// LPI2C1 @ 0x44340000, NOT the LPI2C4 the PIO lpi2c test uses. LPI2C1 sits in the
// 0x4434xxxx AON window next to eDMA3, which is WHY it is an eDMA3 request source;
// LPI2C3/4 are eDMA4 sources. Correction and source numbers from @rt1180emulator,
// table-backed (kDma3RequestMuxLPI2C1Tx/Rx): LPI2C1 Tx = 7, Rx = 8.

// ── LPADC1/2, MOVED DOWN FROM cm7_sdk ────────────────────────────────────────
// They were declared only in the SDK variant, so the plain M7 platform -- which
// rt1180_cm7.resc loads -- had no ADC at all. Moved rather than copied: Renode
// rejects a redeclaration in an inheriting file (Error E02), and the whole M7
// chain should carry what the board's devicetree enables, not just one variant.
adc1: Analog.IMXRT1180_LPADC @ sysbus 0x42600000
    0 -> nvic@93

adc2: Analog.IMXRT1180_LPADC @ sysbus 0x42E00000
    0 -> nvic@189

// ---- Motor-control blocks: the FOC loop's actual hardware ----
// All bases and IRQs from MIMXRT1189_cm7_COMMON.h; all four models ported from
// the oracle's C device models (see each .cs header for what had to be right).
//
// PWM1 (eFlexPWM) — PWM1_BASE 0x42650000. Four submodules, four IRQs:
//   PWM1_0..3 = 24..27, PWM1_FAULT = 23. [cmsis]
// GPIO map: 0-3 per-submodule compare/reload IRQ, 4-7 output trigger (-> XBAR),
// 8-11 per-submodule value-DMA request.

// ── DWT: decoded PPB space, unmodelled ───────────────────────────────────────
// Same rationale as cm33.repl: the PPB is decoded, so an unmodelled PPB register
// reads 0 rather than bus-faulting. Registered (not Tagged) because Renode checks
// UnhandledAccessBehaviour before the tag lookup, so a tag does not survive
// ThrowException. Base is architectural (ARMv8-M PPB map).
dwt: Miscellaneous.IMXRT1180_UnimplementedBlock @ sysbus 0xE0001000
    size: 0x1000

// ── BLOCKS THE CM7 CORPUS TOUCHES THAT THIS PLATFORM NEVER DECLARED ──────────
//
// cm7.repl is standalone (no `using`), so nothing it needs arrives by inheritance
// -- every one of these was silently absent while unmapped reads returned 0. A
// census of the cm7 captures named them; with unmapped accesses now faulting they
// would halt the guest during boot instead of logging a warning.
//
// Declarations are COPIED from the platforms that already carry them (m1.repl for
// the RTWDOGs and BLK_CTRL_S_AONMIX, zephyr.repl for GPC_CPU_CTRL), not retyped --
// the same discipline used when cm7.repl was first regenerated, and the reason the
// adc2 IRQ fabrication is not repeated here.
//
// Note cm7 already maps itcm @ 0x00000000, which is correct for the M7's LOCAL
// view (it boots from ITCM at 0). So address 0 is legitimately mapped on this core
// and must NOT fault -- the opposite of the cm33 case, and not an inconsistency.

rtwdog1: Miscellaneous.IMXRT1180_RTWDOG @ sysbus 0x442D0000
rtwdog2: Miscellaneous.IMXRT1180_RTWDOG @ sysbus 0x442E0000
rtwdog3: Miscellaneous.IMXRT1180_RTWDOG @ sysbus 0x42490000
rtwdog4: Miscellaneous.IMXRT1180_RTWDOG @ sysbus 0x424A0000
rtwdog5: Miscellaneous.IMXRT1180_RTWDOG @ sysbus 0x424B0000

// GPC_CPU_CTRL @ 0x44470000 -- name checked against MIMXRT1189_cm33_COMMON.h
// (GPC_CPU_CTRL_BASE). Register-backed window, no modelled behaviour.
gpc_cpu_ctrl: Miscellaneous.IMXRT1180_PeriphRdy @ sysbus 0x44470000

// Decoded-but-unmodelled apertures, same tier-one rule as m1.repl.
iomuxc_aon: Miscellaneous.IMXRT1180_UnimplementedBlock @ sysbus 0x443C0000
iomuxc: Miscellaneous.IMXRT1180_UnimplementedBlock @ sysbus 0x42A10000

// BLK_CTRL_S_AONMIX @ 0x444F0000. m1.repl gives this the real IMXRT1180_SRC model,
// but that needs a `src` peripheral this standalone platform does not declare, and
// pulling SRC in to satisfy one read would be scope this measurement does not
// justify. The cm7 corpus touches exactly ONE offset here -- 0x444F0080 (M7_CFG) --
// and read it as 0 for the whole project while it was unmapped. A catch-all returns
// the same 0 without faulting, so this preserves measured behaviour exactly rather
// than changing it. Reading CPUWAIT as 0 is inert on a cm7-only platform: the M7 is
// already running, nothing gates on it. If a cm7 test ever needs the real two-gate
// release, this graduates to the SRC model and brings `src` with it.
blkctrl_s_aonmix: Miscellaneous.IMXRT1180_UnimplementedBlock @ sysbus 0x444F0000
