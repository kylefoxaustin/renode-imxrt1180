 static void v7m_enter_lockup(CPUState *env, bool clear_itstate);
 
+/* [RT1180 PATCH -- Renode defect #13] ARMv8-M stack-limit checking.
+ *
+ * MSPLIM/PSPLIM were readable and writable (helper.c MRS/MSR, cpu.h storage) and
+ * were NEVER COMPARED AGAINST SP anywhere, and CFSR.STKOF did not exist. The
+ * effect is worse than an unimplemented register: an unimplemented PSPLIM would
+ * log an unhandled write and the firmware author would see it, whereas here
+ * `MSR PSPLIM, r0` succeeds, `MRS` reads the value back, every check firmware can
+ * perform passes -- and CONFIG_HW_STACK_PROTECTION on a v8-M part is absent while
+ * appearing present. A stack overflow the silicon would trap runs on into
+ * whatever lies below the stack.
+ *
+ * MEASURED: Zephyr cm33 tests/arch/arm/arm_interrupt sets PSP to
+ * stack_info.start + 0x10 and takes an interrupt so exception-entry stacking
+ * drives PSP below PSPLIM. QEMU raises UsageFault with CFSR.STKOF and Zephyr
+ * reports K_ERR_STACK_CHK_FAIL (reason 2, all-zero ESF); stock Renode took the
+ * interrupt normally and the test asserted "expected_reason has not been reset".
+ */
+static uint32_t v7m_sp_limit(CPUState *env)
+{
+    /* ⚠ SELECT BY WHICH SP IS PHYSICALLY IN regs[13], NOT BY MODE.
+     * The first version asked is_using_process_sp_current(), which consults
+     * in_handler_mode() -- and at the point this is called during exception entry
+     * the NVIC has ALREADY been acknowledged, so v7m.exception is non-zero and the
+     * CPU already counts as being in Handler mode. The frame, however, is still
+     * being pushed on the PRE-EXCEPTION stack (the SP switch happens later, at
+     * switch_v7m_sp(env, false)). So the mode said "main" while regs[13] held PSP,
+     * and the check compared the thread's SP against MSPLIM.
+     *
+     * MEASURED: with the mode-based selection, Zephyr's arm_interrupt stack-overflow
+     * sub-test still failed -- the UsageFault fired, but LATER, on the idle thread
+     * instead of during the test, because it was being measured against the wrong
+     * limit register the whole time.
+     *
+     * This is defect #11's lesson again, one layer down: DO NOT CONSULT THE MODE
+     * AFTER THE MODE HAS CHANGED. v7m.process_sp tracks which physical SP is in
+     * regs[13] right now, which is exactly the stack the frame lands on. */
+    return env->v7m.process_sp ? env->v7m.psplim[env->secure] : env->v7m.msplim[env->secure];
+}
+
+/* Rule RLBTH: the limit check is ignored while a negative-priority exception
+ * (NMI or HardFault) is being taken and CCR.STKOFHFNMIGN is set -- otherwise a
+ * stack overflow inside the HardFault handler would recurse forever.
+ *
+ * ⚠ LABELLED APPROXIMATION. QEMU asks its NVIC directly
+ * (armv7m_nvic_neg_prio_requested). tlib has no such callback, and ADDING one
+ * would change the interop symbol set that this patch's ABI check relies on to
+ * prove the rebuild is compatible. The exception being taken is known here, so
+ * NMI/HardFault is tested directly. FAULTMASK-raised priority is NOT covered by
+ * this approximation; in that narrow case the model faults where hardware would
+ * ignore. Stated, not silently skipped. */
+static bool v7m_stkof_ignored(CPUState *env, int acknowledged_exception)
+{
+    if(!(env->v7m.ccr[env->secure] & FIELD_MASK(V7M_CCR, STKOFHFNMIGN))) {
+        return false;
+    }
+    int nr = acknowledged_exception & ~BANKED_SECURE_EXCP_BIT;
+    return nr == ARMV7M_EXCP_NMI || nr == ARMV7M_EXCP_HARD;
+}
+
+/* Returns true if the frame does NOT fit: sets CFSR.STKOF, parks SP at the limit
+ * and leaves the caller to skip every push. Rule: "Stack pushes below the limit
+ * must not be performed"; whether pushes ABOVE it happen is IMPDEF and we choose
+ * not to, matching QEMU. */
+static bool v7m_check_stack_limit(CPUState *env, uint32_t frame_size, int acknowledged_exception)
+{
+    if(!arm_feature(env, ARM_FEATURE_V8)) {
+        return false;
+    }
+    uint32_t limit = v7m_sp_limit(env);
+    if(env->regs[13] - frame_size >= limit) {
+        return false;
+    }
+    if(v7m_stkof_ignored(env, acknowledged_exception)) {
+        return false;
+    }
+    env->v7m.fault_status[env->secure] |= USAGE_FAULT_STKOF;
+    env->regs[13] = limit;
+    return true;
+}
